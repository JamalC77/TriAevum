<?xml version="1.0" encoding="utf-8"?>
<!-- Milestone Q2: a 2D Horizon OS panel app (no VR intent category), so the game shows flat
     in a panel window. The immersive OpenXR activity replaces it in Q3. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />

        <!-- Installs a side-loaded title module, checks it, then starts the game. -->
        <activity android:name=".TriAevumLauncherActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <layout android:defaultWidth="1280dp" android:defaultHeight="720dp"
                android:minWidth="640dp" android:minHeight="360dp" />
        </activity>

        <!-- SDL owns the Surface and lifecycle. Not exported: only the launcher starts it. -->
        <activity android:name=".TriAevumGameActivity" android:exported="false"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation|density">
            <layout android:defaultWidth="1280dp" android:defaultHeight="720dp"
                android:minWidth="640dp" android:minHeight="360dp" />
        </activity>
    </application>
</manifest>
